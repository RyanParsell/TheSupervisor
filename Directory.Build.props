<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- One version for every assembly, so SupervisorVersion reads the same value wherever it runs. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Single-target net10.0 (L1). TheSupervisor has one user, so the permanent cost of running
    every test twice under multi-targeting buys nothing. Any Machine paired later needs .NET 10.
  -->

</Project>
